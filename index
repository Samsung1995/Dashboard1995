<script>

const CANADIAN_PROVINCES_MAP = {
    "21144": "Ontario",
    "21146": "Quebec",
    "21141": "British Columbia",
    "21140": "Alberta",
    "21142": "Manitoba",
    "21143": "New Brunswick",
    "21148": "Saskatchewan",
    "21147": "Nova Scotia",
    "21145": "Prince Edward Island",
    "21149": "Newfoundland and Labrador",
    "21150": "Yukon",
    "21151": "Northwest Territories",
    "21152": "Nunavut"
};

function normalizeProvince(raw) {
    if (!raw) return "National / Unspecified";
    const s = String(raw).trim();
    if (s.includes("21144") || s.includes("20121") || s.toLowerCase() === "ontario") return "Ontario";
    if (Object.values(CANADIAN_PROVINCES_MAP).includes(s)) return s;
    const m = s.match(/\b(211[4-5][0-9]|2011[3-9]|2012[0-5])\b/) || s.match(/\d+/);
    if (m && CANADIAN_PROVINCES_MAP[m[0]]) return CANADIAN_PROVINCES_MAP[m[0]];
    return "National / Unspecified";
}

const METRIC_META = {
    cost:        { label: "Spend ($)",      fmt: v => "$" + v.toLocaleString('en-US', {minimumFractionDigits:2, maximumFractionDigits:2}) },
    clicks:      { label: "Clicks",         fmt: v => Math.round(v).toLocaleString('en-US') },
    impressions: { label: "Impressions",    fmt: v => Math.round(v).toLocaleString('en-US') },
    conversions: { label: "Conversions",    fmt: v => v.toLocaleString('en-US', {minimumFractionDigits:1, maximumFractionDigits:1}) },
    cpc:         { label: "Avg CPC ($)",    fmt: v => "$" + v.toFixed(2) },
    ctr:         { label: "CTR (%)",        fmt: v => v.toFixed(2) + "%" },
    cpa:         { label: "CPA ($ / Conv)", fmt: v => "$" + v.toFixed(2) }
};

document.querySelectorAll('.metric-select').forEach(sel => {
    const def = sel.getAttribute('data-default');
    sel.innerHTML = '';
    Object.entries(METRIC_META).forEach(([k, meta]) => {
        const opt = document.createElement('option');
        opt.value = k;
        opt.innerText = meta.label;
        if (k === def) opt.selected = true;
        sel.appendChild(opt);
    });
});

let campSortCol = 'cost';
let campSortAsc = false;
let currentCampaignRows = [];

let geoSortCol = 'cost';
let geoSortAsc = false;
let currentGeoRows = [];

function computeDerived(row) {
    const impr = num(row.impressions);
    const clk = num(row.clicks);
    const cost = num(row.cost);
    const conv = num(row.conversions);
    return {
        impressions: impr,
        clicks: clk,
        cost: cost,
        conversions: conv,
        cpc: clk > 0 ? (cost / clk) : 0,
        ctr: impr > 0 ? (clk / impr * 100) : 0,
        cpa: conv > 0 ? (cost / conv) : 0
    };
}

function switchTab(tab) {
    ['executive', 'geo', 'demo', 'device'].forEach(t => {
        document.getElementById('view-' + t).classList.toggle('hidden', t !== tab);
        document.getElementById('tab-' + t).classList.toggle('active', t === tab);
    });
    window.dispatchEvent(new Event('resize'));
}

function num(v) {
    const n = parseFloat(v);
    return isNaN(n) ? 0 : n;
}

function getCleanLayout(y1Title, y2Title = null, bottomMargin = 60, tickAngle = 0) {
    const layout = {
        paper_bgcolor: 'rgba(0,0,0,0)',
        plot_bgcolor: 'rgba(0,0,0,0)',
        font: { color: '#FFFFFF', family: 'Inter, sans-serif' },
        margin: { t: 42, l: 65, r: y2Title ? 65 : 25, b: bottomMargin },
        legend: {
            orientation: 'h',
            y: 1.12,
            x: 0,
            font: { color: '#FFFFFF', size: 12 }
        },
        xaxis: {
            gridcolor: '#1E293B',
            tickfont: { color: '#FFFFFF', size: 11 },
            tickangle: tickAngle,
            automargin: true
        },
        yaxis: {
            title: { text: y1Title, font: { color: '#FFFFFF', size: 12 } },
            gridcolor: '#1E293B',
            tickfont: { color: '#FFFFFF', size: 11 },
            automargin: true
        }
    };
    if (y2Title) {
        layout.yaxis2 = {
            title: { text: y2Title, font: { color: '#FFFFFF', size: 12 } },
            overlaying: 'y',
            side: 'right',
            showgrid: false,
            tickfont: { color: '#FFFFFF', size: 11 },
            automargin: true
        };
    }
    return layout;
}

// BULLETPROOF ENFORCED INLINE STYLES FOR TABLE ALIGNMENT
function buildAlignedTable(elId, headers, rows) {
    const tbl = document.getElementById(elId);
    if (!rows || rows.length === 0) {
        tbl.innerHTML = '<tr><td class="text-white py-4 px-3" style="text-align: left;">No matching records found.</td></tr>';
        return;
    }
    
    let html = '<thead><tr>';
    headers.forEach((h, idx) => {
        if (idx === 0) {
            html += `<th class="py-2.5 px-3 text-xs uppercase tracking-wider text-white" style="text-align: left !important;">${h}</th>`;
        } else {
            html += `<th class="py-2.5 px-3 text-xs uppercase tracking-wider text-white" style="text-align: right !important;">${h}</th>`;
        }
    });
    html += '</tr></thead><tbody>';
    
    rows.forEach(r => {
        html += '<tr class="hover:bg-slate-800/60 transition">';
        r.forEach((c, idx) => {
            if (idx === 0) {
                html += `<td class="py-2.5 px-3 text-white font-bold" style="text-align: left !important;">${c}</td>`;
            } else {
                html += `<td class="py-2.5 px-3 text-white" style="text-align: right !important; font-family: monospace !important; font-variant-numeric: tabular-nums !important;">${c}</td>`;
            }
        });
        html += '</tr>';
    });
    html += '</tbody>';
    tbl.innerHTML = html;
}

function renderSortableCampaignTable() {
    const tbl = document.getElementById('table-campaigns');
    const cols = [
        { key: 'division',      label: 'Division',    align: 'left' },
        { key: 'campaign_name', label: 'Campaign',    align: 'left' },
        { key: 'cost',          label: 'Spend ($)',   align: 'right' },
        { key: 'impressions',   label: 'Impressions', align: 'right' },
        { key: 'clicks',        label: 'Clicks',      align: 'right' },
        { key: 'ctr',           label: 'CTR %',       align: 'right' },
        { key: 'cpc',           label: 'Avg CPC',     align: 'right' },
        { key: 'conversions',   label: 'Conversions', align: 'right' },
        { key: 'cpa',           label: 'CPA',         align: 'right' }
    ];

    document.getElementById('campaign-count-badge').innerText = `${currentCampaignRows.length} Campaigns`;

    if (currentCampaignRows.length === 0) {
        tbl.innerHTML = '<tr><td class="text-white py-4 px-3" style="text-align: left;">No campaign data found.</td></tr>';
        return;
    }

    const sorted = [...currentCampaignRows].sort((a, b) => {
        const valA = a[campSortCol];
        const valB = b[campSortCol];
        if (typeof valA === 'string') return campSortAsc ? valA.localeCompare(valB) : valB.localeCompare(valA);
        return campSortAsc ? (valA - valB) : (valB - valA);
    });

    let html = '<thead><tr>';
    cols.forEach(c => {
        const arrow = (campSortCol === c.key) ? (campSortAsc ? ' ▲' : ' ▼') : '';
        html += `<th onclick="sortCampaignTable('${c.key}')" class="py-3 px-3 text-xs uppercase tracking-wider text-white" style="text-align: ${c.align} !important;">${c.label}${arrow}</th>`;
    });
    html += '</tr></thead><tbody>';

    sorted.forEach(r => {
        html += '<tr class="hover:bg-slate-800/60 transition">';
